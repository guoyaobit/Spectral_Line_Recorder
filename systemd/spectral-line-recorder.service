[Unit]
Description=Spectral Line Recorder (ZeroMQ to SDFITS)
Wants=network-online.target
After=network-online.target local-fs.target
RequiresMountsFor=/opt/Spectral_Line_Recorder /data

[Service]
Type=simple
User=spectral-recorder
Group=spectral-recorder
WorkingDirectory=/opt/Spectral_Line_Recorder
ExecStartPre=/usr/bin/test -r /opt/Spectral_Line_Recorder/config.yaml
ExecStartPre=/usr/bin/test -r /opt/Spectral_Line_Recorder/vegas_SDFITS_template.txt
ExecStart=/opt/Spectral_Line_Recorder/build/7mm_recorder
StandardOutput=journal
StandardError=journal
SyslogIdentifier=spectral-line-recorder
Restart=no
KillSignal=SIGTERM
KillMode=control-group
TimeoutStopSec=30
UMask=0027
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
